{
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "github.copilot.chat.enable": true,
  "# codegpt.apiKey": "(store your OpenAI key in .env.local as OPENAI_API_KEY)",
  "# codegpt.model": "gpt-5",
  "codegpt.language": "uk",
  "codegpt.response.showCode": true,
  "chatgpt.session.autoStart": true,
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 500,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.fontSize": 14,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "# note": "Не зберігайте реальні API-ключі у репозиторії. Використовуйте секрети або environment variables.",
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "sync",
  "git.confirmSync": false,
  "git.autofetch": true,
  "agent.mode.continuous": true,
  "agent.mode.maxIterations": 50,
  "agent.mode.autoRestartOnError": true,
  "task.quickOpen.skip": false,
  "task.experimental.autoDetection": "on",
  "yaml.validate": true,
  "yaml.schemas": {
    "kubernetes": "/*.yaml",
    "https://json.schemastore.org/github-workflow.json": "/.github/workflows/*.yml"
  },
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.untrustedFiles": "open",
  "chat.tools.terminal.autoApprove": "always",
  "chat.experimental.welcomePrompt": false,
  "chat.editor.experimental.confirmEdit": "never",
  "continue.enableInlineSuggest": false,
  "continue.allowShellCommands": true,
  "continue.confirmBeforeExecute": false,
  "cline.enableCommandExecution": "always",
  "cline.confirmEdits": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": null,
  "telemetry.telemetryLevel": "off",
  "github.copilot.inlineSuggest.enable": true,
  "github.copilot.chat.terminalExecution.showConfirmation": "never",
  "saoudrizwan.claude-dev.autonomous.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "backend/tests"
  ],
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": true,
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": [
    "--line-length=100"
  ],
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/backend",
    "${workspaceFolder}/agents"
  ],
  "python.analysis.typeCheckingMode": "basic",
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/.venv": false
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/backups/**": true,
    "**/logs/**": true
  },
  "extensions.ignoreRecommendations": false,
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}",
    "ENV_FILE": "${workspaceFolder}/.env"
  },
  "terminal.integrated.confirmOnExit": "never",
  "terminal.integrated.confirmOnKill": "never",
  "workbench.confirmBeforeClose": "never",
  "[python]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": null
  },
  "[jsonc]": {
    "editor.defaultFormatter": null
  },
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": false,
    "markdown": true
  },
  "continue.serverUrl": "http://localhost:11434",
  "continue.experimental.multiFileEdit": true,
  "tabnine.experimentalSelfHostedServer": "http://localhost:8080",
  "chat.mcp.serverSampling": {
    "predator12-local/.vscode/mcp.json: 0": {
      "allowedModels": [
        "copilot/gpt-5-mini",
        "copilot/grok-code-fast-1",
        "copilot/gpt-5-codex"
      ]
    }
  },
  "mcpServers": {
    "predator-tools": {
      "command": "npx",
      "args": [
        "ts-node",
        "src/index.ts"
      ],
      "transport": "stdio",
      "env": {
        "PREDATOR_HOME": "/Users/dima/Documents/Predator12/predator12-local",
        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
        "OPENSEARCH_API_KEY": "${env:OPENSEARCH_API_KEY}"
      },
      "timeoutMs": 120000
    }
  },
  "extensions.autoInstall": [
    "predator-auto-approve"
  ]
}
