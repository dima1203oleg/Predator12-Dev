# ==========================================
# GEMINI ORCHESTRATOR & AI MODELS
# ==========================================

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=your_gemini_project_id

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key

# GitHub Copilot
GITHUB_TOKEN=ghp_your_github_token

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key

# ArgoCD
ARGOCD_SERVER=https://argocd.your-domain.com
ARGOCD_AUTH_TOKEN=your_argocd_token

# Azure DevOps (optional)
AZURE_DEVOPS_PAT=your_azure_devops_pat

# OpenAI (legacy support)
OPENAI_API_KEY=sk-your_openai_key
