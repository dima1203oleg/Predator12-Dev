# Global Environment Variables for Predator Analytics

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
DEBUG=true

# ============================================
# Database Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=predator_analytics

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ============================================
# Security
# ============================================
SECRET_KEY=change-this-in-production-to-a-secure-random-key
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Keycloak (SSO/OAuth2)
# ============================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=predator-analytics
KEYCLOAK_CLIENT_ID=predator-client
KEYCLOAK_CLIENT_SECRET=

# ============================================
# HashiCorp Vault (Secrets Management)
# ============================================
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# ============================================
# Voice Services (Ukrainian TTS/STT)
# ============================================

# Google Cloud
GOOGLE_CLOUD_TTS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Speech Services
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ============================================
# AI/ML Services
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# ============================================
# Monitoring & Observability
# ============================================
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ============================================
# Domains (Production)
# ============================================
DOMAIN=predator-analytics.io
API_DOMAIN=api.predator-analytics.io

# ============================================
# Image Registry
# ============================================
IMAGE_REGISTRY=ghcr.io
BACKEND_IMAGE=ghcr.io/your-org/predator-analytics/backend
FRONTEND_IMAGE=ghcr.io/your-org/predator-analytics/frontend

# ============================================
# Version/Release
# ============================================
VERSION=1.0.0
