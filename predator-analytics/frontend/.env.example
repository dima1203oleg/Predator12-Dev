# Frontend Environment Variables Example
# Copy this file to .env.local and update with your values

# ===============================
# NextAuth.js
# ===============================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-secure-random-string-in-production

# ===============================
# Keycloak OAuth2
# ===============================
KEYCLOAK_ID=predator-frontend
KEYCLOAK_SECRET=predator-frontend-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/predator

# ===============================
# Backend API
# ===============================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ===============================
# Feature Flags (Optional)
# ===============================
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_3D_VISUALIZATION=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ===============================
# Analytics (Optional)
# ===============================
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
