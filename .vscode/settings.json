{
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": true,
    "markdown": true,
    "python": true,
    "typescript": true,
    "javascript": true
  },
  "github.copilot.inlineSuggest.enable": true,
  "github.copilot.chat.enable": true,
  "github.copilot.chat.terminalExecution.showConfirmation": "never",
  "github.copilot.advanced": {
    "length": 500,
    "temperature": 0.7,
    "top_p": 1,
    "listCount": 10,
    "inlineSuggestCount": 3
  },
  "deepseek.apiKey": "${env:DEEPSEEK_API_KEY}",
  "deepseek.model": "deepseek-coder-v2",
  "deepseek.baseURL": "https://api.deepseek.com",
  "deepseek.enableCodeCompletion": true,
  "deepseek.enableChat": true,
  "deepseek.temperature": 0.7,
  "deepseek.maxTokens": 4096,
  "continue.enableInlineSuggest": true,
  "continue.allowShellCommands": true,
  "continue.confirmBeforeExecute": false,
  "continue.models": [
    {
      "title": "DeepSeek Coder",
      "provider": "deepseek",
      "model": "deepseek-coder",
      "apiKey": "${env:DEEPSEEK_API_KEY}"
    },
    {
      "title": "Gemini 2.5 Pro",
      "provider": "google",
      "model": "gemini-2.5-pro",
      "apiKey": "${env:GEMINI_API_KEY}"
    },
    {
      "title": "GPT-4o",
      "provider": "openai",
      "model": "gpt-4o",
      "apiKey": "${env:GITHUB_TOKEN}"
    }
  ],
  "cline.enableCommandExecution": "always",
  "cline.confirmEdits": false,
  "cline.anthropicApiKey": "${env:ANTHROPIC_API_KEY}",
  "files.autoSave": "onFocusChange",
  "files.autoSaveDelay": 500,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.formatting.provider": "black",
  "python.testing.pytestEnabled": true,
  "git.enableSmartCommit": true,
  "git.postCommitCommand": "sync",
  "git.confirmSync": false,
  "git.autofetch": true,
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.startupPrompt": "never"
}
