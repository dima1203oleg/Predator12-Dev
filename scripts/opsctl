#!/usr/bin/env bash
set -euo pipefail

# opsctl - Operations control script for Non-Stop Predator workflow
# This script provides subcommands for building, testing, deploying, and managing the application

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Function to display usage
usage() {
    cat <<EOF
Usage: opsctl <command> [options]

Commands:
    build-test-scan     Build, test, and scan the application
    deploy              Deploy the application to a specified environment
    etl-run             Run ETL jobs
    check-gate          Check release gate for an environment
    maybe-release       Conditionally release to an environment

Options:
    -h, --help          Display this help message

Examples:
    opsctl build-test-scan
    opsctl deploy stage --kubeconfig kubeconfig --nonstop
    opsctl etl-run --jobs changed --nonstop
    opsctl check-gate --env prod
    opsctl maybe-release --env prod --timebox 12h

EOF
}

# Build, test, and scan the application
build_test_scan() {
    log_info "Starting build-test-scan process..."
    
    # Check if there are frontend or backend directories
    if [ -d "${REPO_ROOT}/frontend" ]; then
        log_info "Building frontend..."
        if [ -f "${REPO_ROOT}/frontend/package.json" ]; then
            cd "${REPO_ROOT}/frontend"
            npm ci 2>/dev/null || npm install || log_warn "npm install skipped (no package.json or install failed)"
            npm run build 2>/dev/null || log_warn "npm run build skipped"
            npm run test 2>/dev/null || log_warn "npm run test skipped"
            cd "${REPO_ROOT}"
        else
            log_warn "No package.json found in frontend directory"
        fi
    else
        log_warn "No frontend directory found"
    fi
    
    if [ -d "${REPO_ROOT}/backend" ]; then
        log_info "Building backend..."
        if [ -f "${REPO_ROOT}/backend/requirements.txt" ]; then
            python3 -m pip install -q -r "${REPO_ROOT}/backend/requirements.txt" 2>/dev/null || log_warn "pip install skipped"
        fi
        if [ -f "${REPO_ROOT}/requirements.txt" ]; then
            python3 -m pip install -q -r "${REPO_ROOT}/requirements.txt" 2>/dev/null || log_warn "pip install skipped"
        fi
        
        # Run tests if pytest is available
        if command -v pytest &> /dev/null; then
            log_info "Running backend tests..."
            pytest -q --maxfail=1 2>/dev/null || log_warn "pytest skipped or failed"
        fi
    else
        log_warn "No backend directory found"
    fi
    
    # Run any linting if available
    if command -v flake8 &> /dev/null; then
        log_info "Running linting..."
        flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics 2>/dev/null || true
    fi
    
    log_info "Build-test-scan process completed"
}

# Deploy to specified environment
deploy() {
    local env="${1:-stage}"
    local kubeconfig=""
    local nonstop=false
    
    shift || true
    while [[ $# -gt 0 ]]; do
        case $1 in
            --kubeconfig)
                kubeconfig="$2"
                shift 2
                ;;
            --nonstop)
                nonstop=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    
    log_info "Deploying to environment: ${env}"
    
    if [ -n "${kubeconfig}" ]; then
        log_info "Using kubeconfig: ${kubeconfig}"
        export KUBECONFIG="${kubeconfig}"
    fi
    
    if [ "${nonstop}" = true ]; then
        log_info "Non-stop deployment mode enabled"
    fi
    
    # Check if ArgoCD CLI is available
    if command -v argocd &> /dev/null; then
        log_info "ArgoCD CLI found, attempting sync..."
        # Placeholder for actual ArgoCD sync
        log_warn "ArgoCD sync placeholder - implement actual sync logic"
    else
        log_warn "ArgoCD CLI not found, skipping sync"
    fi
    
    # Check for manifests directory
    if [ -d "${REPO_ROOT}/predator-manifests" ]; then
        log_info "Manifests directory found"
    else
        log_warn "Manifests directory not found (may need submodule init)"
    fi
    
    log_info "Deployment to ${env} completed"
}

# Run ETL jobs
etl_run() {
    local jobs="all"
    local nonstop=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --jobs)
                jobs="$2"
                shift 2
                ;;
            --nonstop)
                nonstop=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    
    log_info "Running ETL jobs: ${jobs}"
    
    if [ "${nonstop}" = true ]; then
        log_info "Non-stop mode enabled for ETL"
    fi
    
    # Placeholder for actual ETL logic
    log_warn "ETL run placeholder - implement actual ETL logic"
    
    log_info "ETL jobs completed"
}

# Check release gate for environment
check_gate() {
    local env="${1:-prod}"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --env)
                env="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
    
    log_info "Checking release gate for environment: ${env}"
    
    # Placeholder for actual gate check logic
    # This would typically check metrics, test results, approvals, etc.
    log_warn "Release gate check placeholder - implement actual gate logic"
    
    log_info "Release gate check passed for ${env}"
}

# Conditionally release to environment
maybe_release() {
    local env="${1:-prod}"
    local timebox="24h"
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --env)
                env="$2"
                shift 2
                ;;
            --timebox)
                timebox="$2"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done
    
    log_info "Checking if release should proceed for environment: ${env}"
    log_info "Timebox: ${timebox}"
    
    # Check environment variables
    if [ -n "${AUTO_MERGE:-}" ]; then
        log_info "AUTO_MERGE is set to: ${AUTO_MERGE}"
    fi
    
    if [ -n "${MANIFESTS_REPO:-}" ]; then
        log_info "MANIFESTS_REPO is set"
    fi
    
    if [ -n "${OPS_IMAGE:-}" ]; then
        log_info "OPS_IMAGE is set to: ${OPS_IMAGE}"
    fi
    
    # Placeholder for actual release logic
    log_warn "Maybe-release placeholder - implement actual release logic"
    log_warn "This would typically check conditions and trigger release if appropriate"
    
    log_info "Maybe-release check completed for ${env}"
}

# Main command dispatcher
main() {
    if [ $# -eq 0 ]; then
        usage
        exit 1
    fi
    
    local command="$1"
    shift
    
    case "${command}" in
        build-test-scan)
            build_test_scan "$@"
            ;;
        deploy)
            deploy "$@"
            ;;
        etl-run)
            etl_run "$@"
            ;;
        check-gate)
            check_gate "$@"
            ;;
        maybe-release)
            maybe_release "$@"
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        *)
            log_error "Unknown command: ${command}"
            usage
            exit 1
            ;;
    esac
}

main "$@"
