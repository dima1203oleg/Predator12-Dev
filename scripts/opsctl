#!/bin/bash
set -e

# opsctl - Operations Control Script for Predator12-Dev CI/CD
# This script provides unified commands for build, test, scan, deploy, and ETL operations

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

show_help() {
    cat << EOF
Usage: opsctl <command> [options]

Commands:
  build-test-scan              Build, test, and scan the codebase
  deploy <env>                 Deploy to specified environment (stage/prod)
    --kubeconfig <path>        Path to kubeconfig file
    --nonstop                  Run in non-stop mode
  etl-run                      Run ETL jobs
    --jobs <type>              Job type: 'changed' or 'all'
    --nonstop                  Run in non-stop mode
  check-gate --env <env>       Check release gate for environment
  maybe-release --env <env>    Maybe release to environment
    --timebox <duration>       Time box for release (e.g., 12h)

Examples:
  opsctl build-test-scan
  opsctl deploy stage --kubeconfig kubeconfig --nonstop
  opsctl etl-run --jobs changed --nonstop
  opsctl check-gate --env prod
  opsctl maybe-release --env prod --timebox 12h

EOF
}

cmd_build_test_scan() {
    log_info "Starting build-test-scan pipeline..."
    
    cd "${PROJECT_ROOT}"
    
    # Check if Python project exists
    if [ -f "requirements.txt" ] || [ -f "setup.py" ] || [ -f "pyproject.toml" ]; then
        log_info "Python project detected"
        
        # Install dependencies if requirements.txt exists
        if [ -f "requirements.txt" ]; then
            log_info "Installing Python dependencies..."
            python3 -m pip install --quiet --upgrade pip
            python3 -m pip install --quiet -r requirements.txt || log_warn "Failed to install some Python dependencies"
        fi
        
        # Run Python tests if pytest is available
        if command -v pytest &> /dev/null; then
            log_info "Running Python tests..."
            pytest || log_warn "Some Python tests failed"
        fi
    fi
    
    # Check if Node.js project exists
    if [ -f "package.json" ]; then
        log_info "Node.js project detected"
        
        # Install dependencies
        if [ -f "package-lock.json" ]; then
            log_info "Installing Node.js dependencies..."
            npm ci --quiet || npm install --quiet || log_warn "Failed to install some Node.js dependencies"
        else
            npm install --quiet || log_warn "Failed to install some Node.js dependencies"
        fi
        
        # Run tests if test script exists
        if npm run | grep -q "test"; then
            log_info "Running Node.js tests..."
            npm test || log_warn "Some Node.js tests failed"
        fi
        
        # Run linter if lint script exists
        if npm run | grep -q "lint"; then
            log_info "Running linter..."
            npm run lint || log_warn "Linting found issues"
        fi
    fi
    
    # Security scan - check for common vulnerabilities
    log_info "Running security scan..."
    
    # Check for Python vulnerabilities if safety is available
    if command -v safety &> /dev/null && [ -f "requirements.txt" ]; then
        log_info "Scanning Python dependencies for vulnerabilities..."
        safety check --json || log_warn "Security scan found potential issues"
    fi
    
    # Check for Node.js vulnerabilities
    if [ -f "package.json" ]; then
        log_info "Scanning Node.js dependencies for vulnerabilities..."
        npm audit --audit-level=moderate || log_warn "Security audit found potential issues"
    fi
    
    log_info "Build-test-scan completed successfully"
}

cmd_deploy() {
    local env="${1:-stage}"
    local kubeconfig=""
    local nonstop=false
    
    shift
    while [[ $# -gt 0 ]]; do
        case $1 in
            --kubeconfig)
                kubeconfig="$2"
                shift 2
                ;;
            --nonstop)
                nonstop=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                return 1
                ;;
        esac
    done
    
    log_info "Deploying to environment: ${env}"
    
    if [ -n "$kubeconfig" ]; then
        log_info "Using kubeconfig: ${kubeconfig}"
        export KUBECONFIG="$kubeconfig"
    fi
    
    if [ "$nonstop" = true ]; then
        log_info "Running in non-stop mode"
    fi
    
    # Check if ArgoCD CLI is available
    if command -v argocd &> /dev/null; then
        log_info "ArgoCD CLI detected, syncing application..."
        # In a real scenario, you would sync specific apps
        # argocd app sync predator12-${env} || log_warn "ArgoCD sync failed"
        log_info "ArgoCD sync would be triggered here"
    else
        log_warn "ArgoCD CLI not found, skipping ArgoCD operations"
    fi
    
    # Check if kubectl is available
    if command -v kubectl &> /dev/null && [ -n "$kubeconfig" ]; then
        log_info "Kubectl detected, verifying deployment..."
        # Verify cluster access
        kubectl cluster-info &> /dev/null && log_info "Cluster access verified" || log_warn "Could not verify cluster access"
    fi
    
    log_info "Deployment to ${env} completed"
}

cmd_etl_run() {
    local jobs_type="all"
    local nonstop=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --jobs)
                jobs_type="$2"
                shift 2
                ;;
            --nonstop)
                nonstop=true
                shift
                ;;
            *)
                log_error "Unknown option: $1"
                return 1
                ;;
        esac
    done
    
    log_info "Running ETL jobs (type: ${jobs_type})"
    
    if [ "$nonstop" = true ]; then
        log_info "Running in non-stop mode"
    fi
    
    cd "${PROJECT_ROOT}"
    
    # Check if there are ETL scripts to run
    if [ -d "etl" ]; then
        log_info "ETL directory found"
        # In a real scenario, you would run actual ETL jobs
        # This is a placeholder for the actual ETL logic
        log_info "ETL jobs would be executed here based on type: ${jobs_type}"
    else
        log_info "No ETL directory found, skipping ETL operations"
    fi
    
    log_info "ETL run completed"
}

cmd_check_gate() {
    local env=""
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --env)
                env="$2"
                shift 2
                ;;
            *)
                log_error "Unknown option: $1"
                return 1
                ;;
        esac
    done
    
    if [ -z "$env" ]; then
        log_error "Environment must be specified with --env"
        return 1
    fi
    
    log_info "Checking release gate for environment: ${env}"
    
    # Check basic conditions for release
    local gate_passed=true
    
    # Check if we're on a stable branch
    if [ -d "${PROJECT_ROOT}/.git" ]; then
        local current_branch=$(git -C "${PROJECT_ROOT}" rev-parse --abbrev-ref HEAD)
        log_info "Current branch: ${current_branch}"
        
        if [ "$env" = "prod" ] && [ "$current_branch" != "main" ]; then
            log_warn "Production releases should be from main branch"
            gate_passed=false
        fi
    fi
    
    # Check for recent commits
    if [ -d "${PROJECT_ROOT}/.git" ]; then
        local commit_count=$(git -C "${PROJECT_ROOT}" rev-list --count HEAD~5..HEAD 2>/dev/null || echo "0")
        log_info "Recent commits: ${commit_count}"
    fi
    
    # In a real scenario, you would check:
    # - CI/CD test results
    # - Security scan results
    # - Code review approvals
    # - Staging environment health
    # - etc.
    
    if [ "$gate_passed" = true ]; then
        log_info "Release gate check passed for ${env}"
        return 0
    else
        log_warn "Release gate check failed for ${env}"
        return 1
    fi
}

cmd_maybe_release() {
    local env=""
    local timebox=""
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --env)
                env="$2"
                shift 2
                ;;
            --timebox)
                timebox="$2"
                shift 2
                ;;
            *)
                log_error "Unknown option: $1"
                return 1
                ;;
        esac
    done
    
    if [ -z "$env" ]; then
        log_error "Environment must be specified with --env"
        return 1
    fi
    
    log_info "Maybe releasing to environment: ${env} (timebox: ${timebox:-none})"
    
    # Check if AUTO_MERGE is enabled
    if [ "${AUTO_MERGE:-0}" = "1" ]; then
        log_info "Auto-merge is enabled"
        
        # Check release gate first
        if cmd_check_gate --env "$env"; then
            log_info "Release gate passed, proceeding with release"
            
            # In a real scenario, you would:
            # 1. Create a release PR to manifests repo
            # 2. Auto-merge if conditions are met
            # 3. Trigger deployment via ArgoCD
            # 4. Monitor deployment within timebox
            
            log_info "Would create and merge release PR here"
            log_info "Would trigger deployment to ${env}"
            
            return 0
        else
            log_warn "Release gate did not pass, skipping release"
            return 1
        fi
    else
        log_info "Auto-merge is not enabled, skipping release"
        return 0
    fi
}

# Main command dispatcher
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi
    
    local command=$1
    shift
    
    case $command in
        build-test-scan)
            cmd_build_test_scan "$@"
            ;;
        deploy)
            cmd_deploy "$@"
            ;;
        etl-run)
            cmd_etl_run "$@"
            ;;
        check-gate)
            cmd_check_gate "$@"
            ;;
        maybe-release)
            cmd_maybe_release "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
